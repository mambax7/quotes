{
    "name": "xoopsmodules27x/quotes",
    "type": "xoops-module",
    "description": "Quotes module for XOOPS CMS 2.7+.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2 <8.6",
        "xoops/xmf": "^1.0",
        "xoops/helpers": "^1.0@beta",
        "xoops/smartyextensions": "^1.0@beta"
    },
    "autoload": {
        "psr-4": {
            "XoopsModules\\Quotes\\": "class/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XoopsModules\\Quotes\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.0",
        "xoops/rector-xoops": "^1.0@alpha"
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
        "analyse:baseline": "phpstan analyse --configuration=phpstan.neon.dist --generate-baseline=phpstan-baseline.neon --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "vendor/bin/phpunit --configuration=phpunit.xml.dist",
        "unit": "@test",
        "qa": [
            "@cs:check",
            "@analyse",
            "@rector",
            "@test"
        ]
    }
}
